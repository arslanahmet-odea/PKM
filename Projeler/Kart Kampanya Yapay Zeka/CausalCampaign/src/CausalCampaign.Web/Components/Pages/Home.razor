@page "/"
@rendermode InteractiveServer
@using System.Globalization
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject MicroBucketCatalogService BucketCatalog

<div class="header-bar">
    <div>
        <h2 style="margin:0; font-size:20px;">CausalCampaign — Causal ML (R-Learner) &amp; MILP Dynamic Campaign Decision Engine</h2>
        <span style="color:var(--text-muted); font-size:13px;">3-Layer POS NLP/ML • Robinson R-Learner • Google.OrTools MILP • &lt; 500 ms Real-Time Tracker • Anti-Gaming &amp; Clawback</span>
    </div>
    <div>
        <span class="badge badge-ok">ASP.NET Core 10.0 &amp; EF Core</span>
    </div>
</div>

<div class="tab-bar">
    <button class="tab-btn @(ActiveTab == 1 ? "active" : "")" @onclick="() => ActiveTab = 1">
        📱 1. Mobile App Customer Simulator
    </button>
    <button class="tab-btn @(ActiveTab == 2 ? "active" : "")" @onclick="() => ActiveTab = 2">
        🎛️ 2. Back-Office Management, 8 KPIs, CUPED &amp; Kill-Switch
    </button>
    <button class="tab-btn @(ActiveTab == 3 ? "active" : "")" @onclick="() => ActiveTab = 3">
        🎧 3. Call Center Customer XAI Rationale &amp; Audit
    </button>
</div>

<div class="container">
    @if (!string.IsNullOrWhiteSpace(StatusBannerMessage))
    {
        <div class="card" style="margin-bottom:18px; border-color:@(IsBannerError ? "var(--danger)" : "var(--accent)");">
            <strong>@(IsBannerError ? "⚠️ Alert / Anti-Gaming Block:" : "✅ Operation Result:")</strong> @StatusBannerMessage
        </div>
    }

    @if (ActiveTab == 1)
    {
        <div class="grid-2">
            <!-- LEFT: MOBILE PHONE SIMULATOR -->
            <div class="phone-frame">
                <div style="margin-bottom:14px;">
                    <label style="font-size:12px; color:var(--text-muted);">Simulated Cardholder:</label>
                    <select @onchange="OnCustomerSelectionChanged">
                        <option value="1001" selected="@(SelectedCustomerId == 1001)">Ahmet Yilmaz (Gold • Persuadable • 36,000 TRY Target)</option>
                        <option value="1002" selected="@(SelectedCustomerId == 1002)">Zeynep Kaya (Silver • Cashback Preferred • 22,000 TRY Target)</option>
                        <option value="1004" selected="@(SelectedCustomerId == 1004)">Elif Sahin (Gold • 115-Day Dormant Card • 5,000 TRY Target)</option>
                    </select>
                </div>

                @if (CurrentAudit?.ActiveAssignment is not null && CurrentAudit.ActiveTracker is not null)
                {
                    <div class="card" style="background:#172554; border-color:#1d4ed8; margin-bottom:14px;">
                        <div style="font-size:12px; color:#93c5fd;">@CurrentAudit.ActiveAssignment.MicroBucketName</div>
                        <h3 style="margin:6px 0;">
                            Spend @CurrentAudit.ActiveTracker.TargetAmount.ToString("N0") TRY to Earn
                            @CurrentAudit.ActiveAssignment.AssignedRewardAmount.ToString("N0") TRY
                            @(CurrentAudit.ActiveAssignment.RewardType == "Cashback" ? "Cashback" : "Reward Points")
                        </h3>
                        <p style="font-size:12px; color:#e2e8f0; margin:6px 0 0 0;">
                            <strong>🤖 XAI Decision Rationale:</strong> @CurrentAudit.ActiveAssignment.XaiReasonText
                        </p>
                    </div>

                    <div class="card" style="margin-bottom:14px;">
                        <div style="display:flex; justify-content:space-between; font-size:13px;">
                            <span>Live Spend Goal Progress</span>
                            <strong>@CurrentAudit.ActiveTracker.ProgressPercentage.ToString("N1")%</strong>
                        </div>
                        <div class="progress-track">
                            <div class="progress-fill" style="width:@(Math.Min(100m, CurrentAudit.ActiveTracker.ProgressPercentage).ToString("0.##", CultureInfo.InvariantCulture))%;"></div>
                        </div>
                        <div style="display:flex; justify-content:space-between; font-size:12px; color:var(--text-muted);">
                            <span>Qualified Spend: <strong style="color:white;">@CurrentAudit.ActiveTracker.CurrentQualifiedSpend.ToString("N0") TRY</strong></span>
                            <span>Remaining: <strong style="color:white;">@CurrentAudit.ActiveTracker.RemainingAmount.ToString("N0") TRY</strong></span>
                        </div>
                    </div>

                    <div style="margin-top:12px;">
                        <div style="font-size:12px; color:var(--text-muted); margin-bottom:8px;">
                            🎯 Choose Your Own Benefit (3 Equivalent-Profit Offers - Active Preference Learning):
                        </div>
                        @foreach (var opt in CurrentAudit.AlternativeOptions)
                        {
                            <button class="btn btn-outline @(CurrentAudit.ActiveAssignment.CustomerSelectedOfferIndex == opt.Index ? "selected" : "")"
                                    style="width:100%; text-align:left; margin-bottom:8px;"
                                    disabled="@IsBusy"
                                    @onclick="() => SelectAlternativeOfferAsync(opt.Index)">
                                #@opt.Index — @opt.Title
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- RIGHT: LIVE ISO 8583 POS TRANSACTION & ANTI-GAMING SIMULATOR -->
            <div>
                <div class="card" style="margin-bottom:20px;">
                    <h3 style="margin-top:0;">💳 Live ISO 8583 Authorization, Anti-Gaming, and Clawback Test Panel</h3>
                    <p style="color:var(--text-muted); font-size:13px;">
                        Click any scenario below to route a live transaction through the 3-layer POS enrichment engine and Anti-Gaming filters, updating the tracker in &lt; 500 ms:
                    </p>
                    <div style="display:flex; flex-wrap:wrap; gap:12px;">
                        <button class="btn" disabled="@IsBusy" @onclick="SimulateValidPaymentFacilitatorTxAsync">
                            💳 1. Authorize Valid Tx (IYZICO*TRENDYOL.COM • +4,500 TRY)
                        </button>
                        <button class="btn btn-warn" disabled="@IsBusy" @onclick="SimulateSplitTransactionAntiGamingAsync">
                            🚫 2. Anti-Gaming: Split Tx within 30 Min (PARAM*GETIR • 2,500 TRY)
                        </button>
                        <button class="btn btn-warn" disabled="@IsBusy" @onclick="SimulateCashLikeExcludedMccAsync">
                            🚫 3. Anti-Gaming: Excluded MCC 6051 (ALTINBAS JEWELRY • 10,000 TRY)
                        </button>
                        <button class="btn btn-danger" disabled="@IsBusy" @onclick="SimulateRefundClawbackAsync">
                            ↩️ 4. Process Refund / Reversal (-6,000 TRY • Reward Clawback)
                        </button>
                    </div>
                </div>

                <div class="card">
                    <h3 style="margin-top:0;">📋 Recent Customer Card Transactions and Anti-Gaming Audit Trail</h3>
                    @if (CurrentAudit?.RecentTransactions is not null)
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Auth Code</th>
                                    <th>Raw DE-43 Merchant / MCC</th>
                                    <th>Resolved Brand &amp; Sector</th>
                                    <th>Amount</th>
                                    <th>Status / Rationale</th>
                                    <th>Latency</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in CurrentAudit.RecentTransactions.Take(8))
                                {
                                    <tr>
                                        <td>@tx.AuthorizationCode</td>
                                        <td>@tx.RawMerchantName_DE43 (@tx.RawMcc_DE18)</td>
                                        <td><strong>@tx.ResolvedBrand</strong> / @tx.ResolvedSector</td>
                                        <td>@(tx.IsReversalOrRefund ? "-" : "+")@tx.Amount.ToString("N0") TRY</td>
                                        <td>
                                            @if (tx.IsExcludedByAntiGaming)
                                            {
                                                <span class="badge badge-err">@tx.ExclusionReason</span>
                                            }
                                            else if (tx.IsReversalOrRefund)
                                            {
                                                <span class="badge badge-err">Refund / @(tx.ExclusionReason ?? "Deducted from Tracker")</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-ok">Qualified for Campaign</span>
                                            }
                                        </td>
                                        <td>@tx.ProcessingLatencyMs.ToString("N2") ms</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    }
    else if (ActiveTab == 2)
    {
        @if (DashboardSummary is not null)
        {
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <div>
                    <h3 style="margin:0;">@DashboardSummary.CampaignCode — @DashboardSummary.CampaignName</h3>
                    <span style="font-size:13px; color:var(--text-muted);">
                        Total Budget: @DashboardSummary.TotalBudget.ToString("N0") TRY |
                        Consumed: @DashboardSummary.ConsumedBudget.ToString("N0") TRY |
                        Remaining: @DashboardSummary.RemainingBudget.ToString("N0") TRY
                    </span>
                </div>
                <div style="display:flex; gap:12px;">
                    <button class="btn" disabled="@IsBusy" @onclick="RunPortfolioOptimizationAsync">
                        🚀 Run R-Learner + MILP Portfolio Optimization
                    </button>
                    <button class="btn btn-danger" disabled="@IsBusy" @onclick="TriggerEmergencyKillSwitchAsync">
                        🛑 EMERGENCY HALT (KILL-SWITCH)
                    </button>
                </div>
            </div>

            <div class="grid-4">
                <div class="card">
                    <div style="font-size:12px; color:var(--text-muted);">KPI-1: POS NLP/ML Accuracy (Macro F1)</div>
                    <h2 style="margin:8px 0; color:var(--success);">@((DashboardSummary.Kpi1_PosMacroF1Score * 100m).ToString("N1"))%</h2>
                    <span class="badge badge-ok">Target: =&gt; 92.0%</span>
                </div>
                <div class="card">
                    <div style="font-size:12px; color:var(--text-muted);">KPI-2: Free-Rider (Organic Waste) Ratio</div>
                    <h2 style="margin:8px 0; color:var(--success);">@((DashboardSummary.Kpi2_FreeRiderRatio * 100m).ToString("N1"))%</h2>
                    <span class="badge badge-ok">Target: &lt;= 25.0%</span>
                </div>
                <div class="card">
                    <div style="font-size:12px; color:var(--text-muted);">KPI-3: CUPED Net Incremental ROI</div>
                    <h2 style="margin:8px 0; color:var(--success);">@DashboardSummary.Kpi3_CupedIncrementalRoi.ToString("N2")x</h2>
                    <span class="badge badge-ok">Target: =&gt; 1.35x (+35%)</span>
                </div>
                <div class="card">
                    <div style="font-size:12px; color:var(--text-muted);">KPI-4: Dormant Card Reactivation Rate</div>
                    <h2 style="margin:8px 0; color:var(--success);">@((DashboardSummary.Kpi4_DormantReactivationRate * 100m).ToString("N2"))%</h2>
                    <span class="badge badge-ok">Target: =&gt; 6.50%</span>
                </div>
                <div class="card">
                    <div style="font-size:12px; color:var(--text-muted);">KPI-5: Real-Time Tracker Latency</div>
                    <h2 style="margin:8px 0; color:var(--accent);">@DashboardSummary.Kpi5_AverageTrackerLatencyMs.ToString("N2") ms</h2>
                    <span class="badge badge-ok">Target: &lt; 500 ms</span>
                </div>
                <div class="card">
                    <div style="font-size:12px; color:var(--text-muted);">KPI-6: Google.OrTools MILP Solve Time</div>
                    <h2 style="margin:8px 0; color:var(--accent);">@DashboardSummary.Kpi6_LastMilpSolveSeconds.ToString("N2") s</h2>
                    <span class="badge badge-ok">Target: &lt; 15 Minutes</span>
                </div>
                <div class="card">
                    <div style="font-size:12px; color:var(--text-muted);">KPI-7: Monthly Real Inflation PSI Drift</div>
                    <h2 style="margin:8px 0; color:var(--success);">@DashboardSummary.Kpi7_MonthlyRealPsiDrift.ToString("N4")</h2>
                    <span class="badge badge-ok">Target: PSI &lt; 0.15</span>
                </div>
                <div class="card">
                    <div style="font-size:12px; color:var(--text-muted);">KPI-8: Monotonicity / Fairness Violations</div>
                    <h2 style="margin:8px 0; color:var(--success);">@DashboardSummary.Kpi8_FairnessRuleViolationCount Violations</h2>
                    <span class="badge badge-ok">Target: 0% Rule Violations</span>
                </div>
            </div>

            <div class="card">
                <h3 style="margin-top:0;">🗂️ 20 Standard Micro-Bucket Catalog (Monotonicity / Algorithmic Fairness Guaranteed)</h3>
                <table>
                    <thead>
                        <tr>
                            <th>Bucket ID</th>
                            <th>Micro-Bucket Description</th>
                            <th>Campaign Type</th>
                            <th>Spend Target</th>
                            <th>Reward Amount</th>
                            <th>Default Reward Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in BucketCatalog.GetAllMicroBuckets())
                        {
                            <tr>
                                <td><strong>#@b.MicroBucketId</strong></td>
                                <td>@b.MicroBucketName</td>
                                <td>@b.ApplicableCampaignType</td>
                                <td>@b.BaseTargetAmount.ToString("N0") TRY</td>
                                <td><strong>@b.BaseRewardAmount.ToString("N0") TRY</strong></td>
                                <td>@(b.DefaultRewardType == "Cashback" ? "Cashback" : "Reward Points")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (ActiveTab == 3)
    {
        <div class="card">
            <h3 style="margin-top:0;">🎧 Call Center Customer XAI Rationale and Campaign Audit View</h3>
            @if (CurrentAudit is not null)
            {
                <p>
                    <strong>Customer:</strong> @CurrentAudit.Customer.FullName (@CurrentAudit.Customer.CustomerExternalNo) |
                    <strong>Card:</strong> @CurrentAudit.Customer.CardNumberMasked |
                    <strong>Segment:</strong> @CurrentAudit.Customer.PrestigeSegment |
                    <strong>Available Limit:</strong> @CurrentAudit.Customer.AvailableCreditLimit.ToString("N0") TRY |
                    <strong>Causal Persona:</strong> @CurrentAudit.Customer.SpendElasticityPersona
                </p>

                @if (CurrentAudit.ActiveAssignment is not null)
                {
                    <div class="card" style="background:#0f172a; margin-bottom:16px;">
                        <h4 style="margin-top:0;">🔍 Explainable AI (XAI) Decision Rationale and Feature Contribution Weights</h4>
                        <p>@CurrentAudit.ActiveAssignment.XaiReasonText</p>
                        <ul>
                            @foreach (var feat in CurrentAudit.XaiFeatureContributions)
                            {
                                <li><strong>@feat.Feature:</strong> @((feat.Impact * 100m).ToString("N0"))% Decision Weight</li>
                            }
                        </ul>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource _circuitCts = new();
    private int ActiveTab { get; set; } = 1;
    private int SelectedCustomerId { get; set; } = 1001;
    private int SelectedCampaignId { get; set; } = 1;
    private bool IsBusy { get; set; }
    private CustomerCallCenterAuditDto? CurrentAudit { get; set; }
    private ExecutiveDashboardSummaryDto? DashboardSummary { get; set; }
    private string? StatusBannerMessage { get; set; }
    private bool IsBannerError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ExecuteWithScopeAsync(RefreshScreenDataCoreAsync);
    }

    private async Task OnCustomerSelectionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int customerId))
        {
            SelectedCustomerId = customerId;
            SelectedCampaignId = customerId switch
            {
                1002 => 2,
                1004 => 3,
                _ => 1
            };
            StatusBannerMessage = null;
            await ExecuteWithScopeAsync(RefreshScreenDataCoreAsync);
        }
    }

    private async Task RefreshScreenDataCoreAsync(IServiceProvider sp, CancellationToken ct)
    {
        var campaignAppService = sp.GetRequiredService<ICampaignManagementAppService>();

        var auditRes = await campaignAppService.GetCustomerCallCenterAuditAsync(SelectedCustomerId, SelectedCampaignId, ct);
        if (auditRes.IsSuccess)
        {
            CurrentAudit = auditRes.Value;
        }
        else
        {
            IsBannerError = true;
            StatusBannerMessage = auditRes.Error.Message;
        }

        var dashRes = await campaignAppService.GetExecutiveDashboardSummaryAsync(SelectedCampaignId, ct);
        if (dashRes.IsSuccess)
        {
            DashboardSummary = dashRes.Value;
        }
    }

    private Task SelectAlternativeOfferAsync(byte index)
        => ExecuteWithScopeAsync(async (sp, ct) =>
        {
            if (CurrentAudit?.ActiveAssignment is null) return;

            var campaignAppService = sp.GetRequiredService<ICampaignManagementAppService>();
            var res = await campaignAppService.SelectCustomerOfferPreferenceAsync(
                new SelectAlternativeOfferRequestDto(CurrentAudit.ActiveAssignment.AssignmentId, SelectedCustomerId, index), ct);

            if (res.IsSuccess)
            {
                IsBannerError = false;
                StatusBannerMessage = $"Customer preference updated to option #{index} ({res.Value.Title}) and fed back into the Contextual Bandit model.";
                await RefreshScreenDataCoreAsync(sp, ct);
            }
            else
            {
                IsBannerError = true;
                StatusBannerMessage = res.Error.Message;
            }
        });

    private Task SimulateValidPaymentFacilitatorTxAsync()
        => ExecuteWithScopeAsync(async (sp, ct) =>
        {
            var trackerService = sp.GetRequiredService<IRealtimeOfferTrackerService>();
            var req = new AuthorizeTransactionRequestDto(
                AuthorizationCode: $"AUTH-{Guid.NewGuid().ToString("N")[..8].ToUpperInvariant()}",
                CustomerId: SelectedCustomerId,
                CampaignId: SelectedCampaignId,
                Amount: 4500.00m,
                Currency: "TRY",
                RawMcc_DE18: "5399",
                RawMerchantName_DE43: "IYZICO*TRENDYOL.COM ISTANBUL",
                TransactionTimestampUtc: DateTime.UtcNow);

            var res = await trackerService.ProcessAuthorizationAsync(req, ct);
            if (res.IsSuccess)
            {
                IsBannerError = !res.Value.IsAcceptedForCampaign;
                StatusBannerMessage = res.Value.IsAcceptedForCampaign
                    ? $"IYZICO*TRENDYOL.COM transaction resolved via Layer-2 Regex as '{res.Value.ResolvedBrand}' and +4,500 TRY added to tracker in {res.Value.ProcessingLatencyMs:N2} ms."
                    : res.Value.ExclusionOrClawbackReason;
                await RefreshScreenDataCoreAsync(sp, ct);
            }
            else
            {
                IsBannerError = true;
                StatusBannerMessage = res.Error.Message;
            }
        });

    private Task SimulateSplitTransactionAntiGamingAsync()
        => ExecuteWithScopeAsync(async (sp, ct) =>
        {
            var trackerService = sp.GetRequiredService<IRealtimeOfferTrackerService>();
            var now = DateTime.UtcNow;

            await trackerService.ProcessAuthorizationAsync(new AuthorizeTransactionRequestDto(
                $"AUTH-{Guid.NewGuid().ToString("N")[..8].ToUpperInvariant()}",
                SelectedCustomerId, SelectedCampaignId, 1500m, "TRY", "7399", "PARAM*GETIR PERAKENDE LOJISTIK", now.AddMinutes(-5)), ct);

            var secondSplitRes = await trackerService.ProcessAuthorizationAsync(new AuthorizeTransactionRequestDto(
                $"AUTH-{Guid.NewGuid().ToString("N")[..8].ToUpperInvariant()}",
                SelectedCustomerId, SelectedCampaignId, 2500m, "TRY", "7399", "PARAM*GETIR PERAKENDE LOJISTIK", now), ct);

            if (secondSplitRes.IsSuccess)
            {
                IsBannerError = !secondSplitRes.Value.IsAcceptedForCampaign;
                StatusBannerMessage = secondSplitRes.Value.ExclusionOrClawbackReason ?? "Split transaction processed.";
                await RefreshScreenDataCoreAsync(sp, ct);
            }
            else
            {
                IsBannerError = true;
                StatusBannerMessage = secondSplitRes.Error.Message;
            }
        });

    private Task SimulateCashLikeExcludedMccAsync()
        => ExecuteWithScopeAsync(async (sp, ct) =>
        {
            var trackerService = sp.GetRequiredService<IRealtimeOfferTrackerService>();
            var res = await trackerService.ProcessAuthorizationAsync(new AuthorizeTransactionRequestDto(
                $"AUTH-{Guid.NewGuid().ToString("N")[..8].ToUpperInvariant()}",
                SelectedCustomerId, SelectedCampaignId, 10000m, "TRY", "6051", "ALTINBAS KUYUMCULUK KAPALICARSI", DateTime.UtcNow), ct);

            if (res.IsSuccess)
            {
                IsBannerError = !res.Value.IsAcceptedForCampaign;
                StatusBannerMessage = res.Value.ExclusionOrClawbackReason ?? "Transaction processed.";
                await RefreshScreenDataCoreAsync(sp, ct);
            }
            else
            {
                IsBannerError = true;
                StatusBannerMessage = res.Error.Message;
            }
        });

    private Task SimulateRefundClawbackAsync()
        => ExecuteWithScopeAsync(async (sp, ct) =>
        {
            var trackerService = sp.GetRequiredService<IRealtimeOfferTrackerService>();
            long originalTxId = CurrentAudit?.RecentTransactions.FirstOrDefault(t => !t.IsReversalOrRefund && !t.IsExcludedByAntiGaming)?.TransactionId ?? 100001;

            var res = await trackerService.ProcessReversalOrRefundAsync(new ReversalTransactionRequestDto(
                $"REV-{Guid.NewGuid().ToString("N")[..8].ToUpperInvariant()}",
                SelectedCustomerId, SelectedCampaignId, originalTxId, 6000m, DateTime.UtcNow), ct);

            if (res.IsSuccess)
            {
                IsBannerError = res.Value.RewardClawedBack;
                StatusBannerMessage = res.Value.RewardClawedBack
                    ? res.Value.ExclusionOrClawbackReason
                    : "6,000 TRY refund deducted from the spend goal tracker.";
                await RefreshScreenDataCoreAsync(sp, ct);
            }
            else
            {
                IsBannerError = true;
                StatusBannerMessage = res.Error.Message;
            }
        });

    private Task RunPortfolioOptimizationAsync()
        => ExecuteWithScopeAsync(async (sp, ct) =>
        {
            var campaignAppService = sp.GetRequiredService<ICampaignManagementAppService>();
            var res = await campaignAppService.RunEndToEndCampaignOptimizationAsync(SelectedCampaignId, ct);
            if (res.IsSuccess)
            {
                IsBannerError = false;
                StatusBannerMessage = $"R-Learner + Google.OrTools MILP Optimization completed in {res.Value.SolveDurationSeconds:N3} s. Assigned Treatment: {res.Value.AssignedTreatmentCount}, Control: {res.Value.AssignedControlHoldoutCount}, Excluded Free-Riders: {res.Value.ExcludedFreeRiderCount}, Monotonicity Violations: {res.Value.FairnessMonotonicityViolationCount}.";
                await RefreshScreenDataCoreAsync(sp, ct);
            }
            else
            {
                IsBannerError = true;
                StatusBannerMessage = res.Error.Message;
            }
        });

    private Task TriggerEmergencyKillSwitchAsync()
        => ExecuteWithScopeAsync(async (sp, ct) =>
        {
            var campaignAppService = sp.GetRequiredService<ICampaignManagementAppService>();
            var res = await campaignAppService.TriggerCampaignKillSwitchAsync(
                new TriggerKillSwitchRequestDto(SelectedCampaignId, "Manual emergency halt (Kill-Switch) triggered from the Back-Office panel.", "BackOfficeAdmin"), ct);

            if (res.IsSuccess)
            {
                IsBannerError = true;
                StatusBannerMessage = "Campaign emergency Kill-Switch activated! Tracker progression for new card authorizations is now halted.";
                await RefreshScreenDataCoreAsync(sp, ct);
            }
            else
            {
                IsBannerError = true;
                StatusBannerMessage = res.Error.Message;
            }
        });

    private async Task ExecuteWithScopeAsync(Func<IServiceProvider, CancellationToken, Task> action)
    {
        if (IsBusy) return;
        IsBusy = true;

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            await action(scope.ServiceProvider, _circuitCts.Token);
        }
        catch (OperationCanceledException)
        {
            // Circuit disposed or navigation cancelled
        }
        catch (Exception ex)
        {
            IsBannerError = true;
            StatusBannerMessage = $"Unexpected UI operation error: {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    public void Dispose()
    {
        _circuitCts.Cancel();
        _circuitCts.Dispose();
    }
}
