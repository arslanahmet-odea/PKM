<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>CausalCampaign — Causal ML &amp; MILP Dynamic Campaign Decision Engine</title>
    <style>
        :root {
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --border-color: #334155;
            --accent: #38bdf8;
            --success: #22c55e;
            --warning: #f59e0b;
            --danger: #ef4444;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
        }
        .header-bar {
            background: linear-gradient(90deg, #0f172a 0%, #1e3a8a 100%);
            padding: 16px 28px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .tab-bar {
            display: flex;
            gap: 12px;
            padding: 16px 28px 0 28px;
            border-bottom: 1px solid var(--border-color);
            background-color: #131c31;
        }
        .tab-btn {
            padding: 12px 20px;
            border: 1px solid transparent;
            border-bottom: none;
            border-radius: 8px 8px 0 0;
            background: transparent;
            color: var(--text-muted);
            font-weight: 600;
            cursor: pointer;
            font-size: 14px;
        }
        .tab-btn.active {
            background-color: var(--card-bg);
            color: var(--accent);
            border-color: var(--border-color);
        }
        .container { padding: 24px 28px; }
        .grid-2 { display: grid; grid-template-columns: 420px 1fr; gap: 24px; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 20px;
        }
        .phone-frame {
            background: #0b1120;
            border: 3px solid #475569;
            border-radius: 28px;
            padding: 20px;
            box-shadow: 0 12px 32px rgba(0,0,0,0.45);
        }
        .progress-track {
            background-color: #334155;
            border-radius: 999px;
            height: 18px;
            overflow: hidden;
            margin: 12px 0;
        }
        .progress-fill {
            background: linear-gradient(90deg, #0284c7, #22c55e);
            height: 100%;
            transition: width 0.3s ease;
        }
        .btn {
            padding: 10px 16px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background-color: #2563eb;
            color: white;
            font-weight: 600;
            cursor: pointer;
            font-size: 13px;
        }
        .btn-warn { background-color: #d97706; }
        .btn-danger { background-color: #dc2626; }
        .btn-outline { background-color: #1e293b; color: var(--text-main); }
        .btn-outline.selected { border-color: var(--accent); background-color: #0c4a6e; }
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
        }
        .badge-ok { background-color: rgba(34,197,94,0.18); color: #4ade80; }
        .badge-err { background-color: rgba(239,68,68,0.18); color: #f87171; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border-color); }
        th { color: var(--text-muted); font-weight: 600; }
        select {
            background-color: #0f172a;
            color: white;
            border: 1px solid var(--border-color);
            padding: 10px 14px;
            border-radius: 8px;
            width: 100%;
            font-size: 14px;
        }
    </style>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
