<td style=3D"text-align: center;vertical-align: middle;" class=3D"confluen=
ceTd"><h2 id=3D"ODEA028Yaz=C4=B1l=C4=B1mGeli=C5=9FtirmeProjeYaz=C4=B1mTasl=
a=C4=9F=C4=B1-Proje=C4=B0=C5=9FPlan=C4=B1"><span style=3D"color: rgb(0,0,0=
);"><strong>Proje =C4=B0=C5=9F Plan=C4=B1</strong></span></h2></td>
<td class=3D"confluenceTd">
<div class=3D"content-wrapper">
