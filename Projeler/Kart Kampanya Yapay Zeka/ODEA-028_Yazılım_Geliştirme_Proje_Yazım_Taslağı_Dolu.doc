<td style=3D"text-align: center;vertical-align: middle;" class=3D"confluen=
ceTd"><h2 id=3D"ODEA028Yaz=C4=B1l=C4=B1mGeli=C5=9FtirmeProjeYaz=C4=B1mTasl=
a=C4=9F=C4=B1-Yenilik=C3=A7iY=C3=B6n=C3=BC"><span style=3D"color: rgb(0,0,=
0);"><strong>Yenilik=C3=A7i Y=C3=B6n=C3=BC</strong></span></h2></td>
<td class=3D"confluenceTd"><span style=3D"color: rgb(0,0,0);">Bu b=C3=B6l=
=C3=BCmde projenin <strong>yenilik=C3=A7i ve =C3=B6zg=C3=BCn y=C3=B6nleri<=
/strong> a=C3=A7=C4=B1k =C5=9Fekilde vurgulanmal=C4=B1d=C4=B1r.</span><br>=
<span style=3D"color: rgb(0,0,0);">=C3=96nerilen =C3=BCr=C3=BCn/s=C3=BCre=
=C3=A7 yenili=C4=9Fi ile;</span>
<ul>
