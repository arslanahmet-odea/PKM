			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Yanıtı JSON olarak al\r",
							"let response = pm.response.json();\r",
							"\r",
							"// İlk elemanın shadowCardNumber değerini al\r",
							"let shadowCardNumber = response.virtualCardWithLimits?.[0]?.shadowCardNumber;\r",
							"\r",
							"// Değer mevcutsa environment variable olarak ayarla\r",
							"if (shadowCardNumber) {\r",
							"    pm.environment.set(\"shadowCardNumber\", shadowCardNumber);\r",
							"    console.log(\"shadowCardNumber set edildi:\", shadowCardNumber);\r",
							"} else {\r",
